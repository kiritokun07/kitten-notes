{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "default_locale": "zh_CN",
  "version": "0.3.1",
  "description": "__MSG_description__",
  "permissions": ["storage", "sidePanel", "contextMenus"],
  "content_security_policy": {"extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; connect-src 'none'; img-src 'none'; base-uri 'none'"},
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "action": {"default_title": "打开小猫便签", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}},
  "background": {"service_worker": "background.js"},
  "side_panel": {"default_path": "panel.html"},
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["selection.js"],
    "all_frames": true
  }]
}
